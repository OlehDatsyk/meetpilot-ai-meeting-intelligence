# MeetPilot AI configuration. Copy to .env and adjust. Never commit .env.
# Required in production: DATABASE_URL, SECRET_KEY, CORS_ORIGINS, FRONTEND_URL.

# --- Core ---------------------------------------------------------------------
ENVIRONMENT=development                 # development | production
DATABASE_URL=sqlite:///./data/meetpilot.db   # production: postgresql://user:pass@host:5432/db
SECRET_KEY=                             # 32+ random characters; required in production
FRONTEND_URL=http://localhost:5173      # used in password-reset links
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# ACCESS_TOKEN_MINUTES=720

# --- Storage ------------------------------------------------------------------
STORAGE_PROVIDER=local                  # local | s3
STORAGE_ROOT=./data/storage
STORAGE_PERSISTENT=true                 # false shows a warning banner (e.g. ephemeral disks)
MAX_AUDIO_SIZE_MB=200
MAX_AUDIO_DURATION_MINUTES=240
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=                      # for S3-compatible services (R2, B2, MinIO...)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=meetpilot/

# --- Transcription ------------------------------------------------------------
TRANSCRIPTION_PROVIDER=none             # none | openai | local
# TRANSCRIPTION_API_KEY=                # OpenAI key for transcription (falls back to OPENAI_API_KEY)
# TRANSCRIPTION_MODEL=                  # openai default: gpt-4o-transcribe-diarize; local default: tiny
# TRANSCRIPTION_DIARIZE=true
# TRANSCRIPTION_LANGUAGE=               # ISO-639-1, e.g. en; empty = auto-detect
# TRANSCRIPTION_CHUNK_SECONDS=1200
# LOCAL_WHISPER_MODEL=tiny              # local only: tiny | base | small ... (needs requirements-local.txt)
# LOCAL_WHISPER_THREADS=2

# --- AI analysis --------------------------------------------------------------
AI_PROVIDER=none                        # none | openai | anthropic | gemini
# AI_API_KEY=                           # key for AI_PROVIDER (or use the provider-specific keys below)
# AI_MODEL=                             # defaults: openai gpt-5-mini, anthropic claude-opus-5-5, gemini gemini-2.5-flash
# AI_FALLBACK_PROVIDERS=                # e.g. gemini,openai (each needs its own key below)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AUTO_ANALYZE=true

# --- Background jobs ----------------------------------------------------------
EMBEDDED_WORKER=true                    # false when running `python -m app.worker` separately
# JOB_MAX_ATTEMPTS=3
# JOB_TIMEOUT_SECONDS=3600

# --- Optional -----------------------------------------------------------------
# DEMO_ENABLED=true
# RATE_LIMIT_ENABLED=true
# SMTP_HOST=                            # enables password-reset emails
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
